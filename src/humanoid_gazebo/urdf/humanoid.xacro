<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find humanoid_description)/urdf/humanoid.xacro"/>
  <xacro:include filename="$(find humanoid_gazebo)/urdf/transmissions/leg_transmissions_macro.xacro"/>
  <xacro:include filename="$(find humanoid_gazebo)/urdf/ros2_control.xacro"/>
  <xacro:leg_transmissions_macro prefix="left_"/>
  <xacro:leg_transmissions_macro prefix="right_"/>

  <xacro:humanoid_ros2_control/>

  <gazebo reference="left_foot_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
    <kp>2000000.0</kp>
    <kd>100.0</kd>
    <min_depth>0.001</min_depth>
    <max_vel>0.01</max_vel>
  </gazebo>

  <gazebo reference="right_foot_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
    <kp>2000000.0</kp>
    <kd>100.0</kd>
    <min_depth>0.001</min_depth>
    <max_vel>0.01</max_vel>
  </gazebo>

  <gazebo>
    <!-- Joint state publisher -->
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find humanoid_gazebo)/config/ros2_control_controllers.yaml</parameters>
    </plugin>
    <plugin name="base_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <body_name>base</body_name>
      <frame_name>world</frame_name>
      <update_rate>100.0</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference="left_ankle_pitch">
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="right_ankle_pitch">
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <!-- Ankle force/torque sensors. They publish the ankle_pitch joint wrench in the
       foot_link frame (ankle), measured from child (foot) to parent. -->
  <gazebo>
    <plugin name="left_foot_ft" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <remapping>wrench:=left_foot_ft</remapping>
      </ros>
      <joint_name>left_ankle_pitch</joint_name>
      <update_rate>500.0</update_rate>
    </plugin>
    <plugin name="right_foot_ft" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <remapping>wrench:=right_foot_ft</remapping>
      </ros>
      <joint_name>right_ankle_pitch</joint_name>
      <update_rate>500.0</update_rate>
    </plugin>
  </gazebo>

</robot>
