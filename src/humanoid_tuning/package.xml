  <version>0.0.0</version>
  <description>Floating single-joint PD experiments with rqt and PlotJuggler 4.</description>
  <maintainer email="grotelueschen@campus.tu-berlin.de">bjarne</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
