<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find humanoid_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find humanoid_description)/urdf/inertia.xacro"/>
  <xacro:include filename="$(find humanoid_description)/urdf/links/torso.xacro"/>
  <xacro:include filename="$(find humanoid_description)/urdf/links/leg_macro.xacro"/>
  <xacro:include filename="$(find humanoid_description)/urdf/joints/leg_joints_macro.xacro"/>

  <xacro:arg name="floating" default="false"/>
  <xacro:if value="$(arg floating)">
    <link name="world"/>
    <joint name="world_to_base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="base"/>
    </joint>
  </xacro:if>

  <link name="base"/>
  <joint name="base_to_torso" type="fixed">
    <origin xyz="0 0 1.1" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="torso_link"/>
  </joint>
  <xacro:torso_macro/>
  <xacro:leg_macro side="left" prefix="left_"/>
  <xacro:leg_joints_macro side="left" prefix="left_" x_offset="${hip_x_offset}"/>
  <xacro:leg_macro side="right" prefix="right_"/>
  <xacro:leg_joints_macro side="right" prefix="right_" x_offset="${-hip_x_offset}"/>
</robot>
