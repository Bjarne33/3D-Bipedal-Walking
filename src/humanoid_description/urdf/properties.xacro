<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Link geometry properties -->
  <xacro:property name="torso_x" value="0.35"/>
  <xacro:property name="torso_y" value="0.2"/>
  <xacro:property name="torso_z" value="0.5"/>

  <xacro:property name="thigh_radius" value="0.07"/>
  <xacro:property name="thigh_length" value="0.4"/>
  <xacro:property name="shin_radius" value="0.06"/>
  <xacro:property name="shin_length" value="0.4"/>
  <xacro:property name="foot_x" value="0.15"/>
  <xacro:property name="foot_y" value="0.3"/>
  <xacro:property name="foot_z" value="0.05"/>

  <!-- Link mass properties -->
  <xacro:property name="torso_mass" value="20.0"/>
  <xacro:property name="hip_yaw_mass" value="0.1"/>
  <xacro:property name="hip_pitch_mass" value="0.1"/>
  <xacro:property name="thigh_mass" value="5.0"/>
  <xacro:property name="shank_mass" value="3.0"/>
  <xacro:property name="ankle_mass" value="0.1"/>
  <xacro:property name="foot_mass" value="1.0"/>
  <xacro:property name="dummy_link_inertia" value="1e-4"/>

  <!-- Joint offsets and origins -->
  <xacro:property name="hip_x_offset" value="0.125"/>
  <xacro:property name="hip_roll_origin_z" value="${(-torso_z)/2}"/>
  <xacro:property name="knee_origin_z" value="${-thigh_length}"/>
  <xacro:property name="ankle_roll_origin_z" value="${-shin_length}"/>

  <!-- Joint limits -->
  <xacro:property name="hip_yaw_limit_lower" value="-1.0"/>
  <xacro:property name="hip_yaw_limit_upper" value="1.0"/>

  <xacro:property name="hip_roll_limit_lower" value="-0.6"/>
  <xacro:property name="hip_roll_limit_upper" value="0.6"/>

  <xacro:property name="hip_pitch_limit_lower" value="-1.5"/>
  <xacro:property name="hip_pitch_limit_upper" value="1.2"/>

  <xacro:property name="knee_pitch_limit_lower" value="-2.4"/>
  <xacro:property name="knee_pitch_limit_upper" value="0"/>

  <xacro:property name="ankle_pitch_limit_lower" value="-0.5"/>
  <xacro:property name="ankle_pitch_limit_upper" value="0.8"/>

  <xacro:property name="ankle_roll_limit_lower" value="-0.3"/>
  <xacro:property name="ankle_roll_limit_upper" value="0.3"/>

  <xacro:property name="hip_yaw_limit_effort" value="200"/>
  <xacro:property name="hip_roll_limit_effort" value="200"/>
  <xacro:property name="hip_pitch_limit_effort" value="220"/>
  <xacro:property name="knee_pitch_limit_effort" value="180"/>
  <xacro:property name="ankle_pitch_limit_effort" value="120"/>
  <xacro:property name="ankle_roll_limit_effort" value="120"/>
  <xacro:property name="leg_joint_limit_velocity" value="5.0"/>

</robot>
